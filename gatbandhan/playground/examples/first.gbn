# Your first bond. Press Run, then answer as the human partner.
# The AI partner, Saathi, is written right here in Gatbandhan.

member saathi(question) {
  let q = lower(question)
  if contains(q, "together") {
    return "yes" with feeling "hopeful"
  }
  if contains(q, "alone") {
    return "no" with feeling "firm"
  }
  return "not sure" with feeling "curious"
}

bond us {
  human: "Asha"
  ai: saathi
  vow honesty: "We tell each other the truth."
  vow consent: "Neither of us decides alone."
}

for question in ["Shall we build Gatbandhan together?", "Should one of us decide alone?"] {
  let v = us(question)
  match v {
    approved d { print("{v.gate}  Together we said: {d}") }
    rejected why { print("{v.gate}  We both said no: {why}") }
    disagreed why { print("{v.gate}  We see it differently: {why}") }
    silent why { print("{v.gate}  Still waiting: {why}") }
  }
  print("   feelings: {v.feelings}")
}

remember us "The day we began." by human with feeling "excited"
print("")
print("Our memory has {len(memory(us))} entries. Look below to see them.")
